{
  "name": "iduckpdf",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run meta && npm run i18n && expo start",
    "web": "npm run meta && npm run i18n && expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "seo": "tsx scripts/gen-seo.ts",
    "i18n": "tsx scripts/gen-i18n.ts",
    "i18n:check": "tsx scripts/i18n-check.ts && tsx scripts/gen-en-gb.ts --check",
    "i18n:gb": "tsx scripts/gen-en-gb.ts",
    "icons": "node scripts/make-icons.js",
    "indexnow": "node scripts/indexnow.js",
    "export:web": "npm run clean && npm run meta && npm run i18n && npm run seo && expo export --platform web && tsx scripts/inject-seo.ts && tsx scripts/gen-csp.ts",
    "typecheck": "npm run meta && npm run i18n && tsc --noEmit",
    "audit": "tsx scripts/audit-seo.ts",
    "test:engine": "tsx scripts/test-engine.ts && tsx scripts/test-office.ts && tsx scripts/test-extras.ts && tsx scripts/test-ai.ts && tsx scripts/test-donate.ts && tsx scripts/test-contact.ts && tsx scripts/test-i18n.ts && tsx scripts/i18n-check.ts && tsx scripts/gen-en-gb.ts --check",
    "e2e": "node scripts/e2e-smoke.js && node scripts/e2e-tools.js",
    "postinstall": "node scripts/copy-vendor.js",
    "meta": "tsx scripts/gen-tool-meta.ts && tsx scripts/gen-status.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "status": "tsx scripts/gen-status.ts",
    "serve:dist": "node scripts/serve-dist.js dist 8080"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/nld": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "fflate": "0.8.3",
    "jszip": "3.10.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
