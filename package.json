{
  "name": "iduckpdf",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run meta && expo start",
    "web": "npm run meta && expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "seo": "tsx scripts/gen-seo.ts",
    "icons": "node scripts/make-icons.js",
    "export:web": "npm run clean && npm run meta && npm run seo && expo export --platform web && tsx scripts/inject-seo.ts",
    "typecheck": "npm run meta && tsc --noEmit",
    "audit": "tsx scripts/audit-seo.ts",
    "test:engine": "tsx scripts/test-engine.ts",
    "e2e": "node scripts/e2e-smoke.js",
    "postinstall": "node scripts/copy-vendor.js",
    "meta": "tsx scripts/gen-tool-meta.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
